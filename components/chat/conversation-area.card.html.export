<!-- @dsCard group="Chat" viewport="760x520" name="Conversation Area" subtitle="Message list — user, agent, status, typing" -->
<!DOCTYPE html>
<html>
<head>
<link rel="stylesheet" href="../../styles.css">
<link rel="stylesheet" href="../../salt-components.css">
<link rel="stylesheet" href="./ConversationArea.css">
<link rel="stylesheet" href="../data/FileResultsGrid.css">
<script src="https://unpkg.com/react@18.3.1/umd/react.development.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" crossorigin></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" crossorigin></script>
<script src="../../_ds_bundle.js?v=16"></script>
<style>html,body{margin:0;height:100%;background:var(--salt-container-primary-background)}#root{height:100%}</style>
</head>
<body class="salt-theme">
<div id="root"></div>
<script type="text/babel">
const { ConversationArea } = window.FusionDesignSystem_6db751;
function App() {
  const [messages, setMessages] = React.useState([
    { role: "user", text: "Triage the last 60 days of advisory-desk emails and produce a leadership-ready summary. I want it broken out by theme, by urgency tier, and by desk owner so we can see where the backlog is concentrated, plus a short narrative at the top calling out anything that needs escalation before Friday's leadership sync.", timestamp: Date.now() - 1000 * 60 * 60, versionCount: 2, activeVersion: 2, attachments: [{ title: "advisory-desk-emails.zip", description: "60-day export", fileType: "zip" }, { title: "org-chart.pdf", description: "Desk owners", fileType: "pdf" }] },
    { role: "status", text: "Connecting to Microsoft Graph API…", done: true },
    { role: "status", text: "Clustering by theme — 8 themes identified…", done: true },
    { role: "status", text: "Flagging Platinum-tier urgencies — 12 flagged…", done: false },
    { role: "user", text: "Here's a screenshot of the dashboard we're matching the layout to.", timestamp: Date.now() - 1000 * 60 * 30, attachments: [{ title: "dashboard.png", fileType: "png", imageUrl: "https://picsum.photos/seed/fusion/640/360" }] },
    { role: "agent", name: "Builder_Agent_v2", time: "4:43pm", blocks: [
      { type: "h1", text: "Advisory Desk Email Summary" },
      { type: "h2", text: "Overview" },
      { type: "h3", text: "Scope" },
      { type: "h4", text: "Method" },
      { type: "body", text: "This summary covers **12 flagged** items across *8 themes*. See the ~~draft~~ final numbers below, or run `triage --recheck` to refresh. Full source: https://fusion.jpmc.com/reports/advisory-q3 — or read the [methodology notes](https://fusion.jpmc.com/docs/methodology) for details." },
      { type: "blockquote", text: "Escalate anything tagged Platinum before Friday's sync.", children: { text: "Per the desk-owner playbook, Platinum items page the on-call lead directly." } },
      { type: "ol", items: [
        { text: "Pull the 60-day export", children: [
          { text: "Filter to advisory-desk mailboxes", children: [
            { text: "Exclude auto-replies" },
          ] },
        ] },
        { text: "Cluster by theme" },
      ] },
      { type: "ul", items: [
        { text: "Platinum tier", children: [
          { text: "Escalate same-day", children: [
            { text: "Notify desk owner", children: [
              { text: "Page on-call if unread after 1hr" },
            ] },
          ] },
        ] },
        { text: "Gold tier" },
      ] },
      { type: "disclaimer", text: "AI-generated summary — verify figures against the source export before distributing." },
      { type: "files", files: [
        { id: 1, name: "advisory-desk-emails.zip", size: 84000000, type: "ZIP" },
        { id: 2, name: "org-chart.pdf", size: 512000, type: "PDF" },
      ], columns: [{ key: "type", label: "Type" }] },
    ] },
    { role: "typing", name: "Builder_Agent_v2" },
  ]);
  const submitEdit = (m, newText, i) => {
    setMessages((prev) => prev.map((msg, idx) => idx === i ? { ...msg, text: newText, versionCount: (msg.versionCount || 1) + 1, activeVersion: (msg.versionCount || 1) + 1 } : msg));
  };
  const changeVersion = (m, v, i) => {
    setMessages((prev) => prev.map((msg, idx) => idx === i ? { ...msg, activeVersion: v } : msg));
  };
  return <div style={{ height: "100%", display: "flex", flexDirection: "column" }}>
    <ConversationArea
      messages={messages}
      onCopyMessage={(m) => navigator.clipboard && navigator.clipboard.writeText(m.text)}
      onSubmitEdit={submitEdit}
      onChangeVersion={changeVersion}
    />
  </div>;
}
ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
